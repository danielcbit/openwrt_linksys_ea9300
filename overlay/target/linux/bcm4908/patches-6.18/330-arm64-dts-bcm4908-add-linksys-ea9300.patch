From: OpenWrt community
Subject: arm64: dts: broadcom: bcm4908: add Linksys EA9300

--- a2/arch/arm64/boot/dts/broadcom/bcmbca/Makefile	2026-10-22 16:01:05
+++ b2/arch/arm64/boot/dts/broadcom/bcmbca/Makefile	2026-10-22 16:01:05
@@ -4,6 +4,7 @@
 				bcm4906-tplink-archer-c2300-v1.dtb \
 				bcm4906-zyxel-ex3510b.dtb \
 				bcm4908-asus-gt-ac5300.dtb \
+				bcm4908-linksys-ea9300.dtb \
 				bcm4908-netgear-raxe500.dtb \
 				bcm94908.dtb \
 				bcm4912-asus-gt-ax6000.dtb \

--- /dev/null	2026-10-22 20:17:59
+++ b2/arch/arm64/boot/dts/broadcom/bcmbca/bcm4908-linksys-ea9300.dts	2026-10-22 20:17:41
@@ -0,0 +1,312 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+#include "bcm4908.dtsi"
+
+/ {
+	compatible = "linksys,ea9300", "brcm,bcm4908", "brcm,bcmbca";
+	model = "Linksys EA9300 (Max-Stream AC4000 Tri-Band)";
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00 0x00 0x00 0x20000000>;
+	};
+
+	gpio-keys-polled {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		key-wps {
+			label = "WPS";
+			linux,code = <KEY_WPS_BUTTON>;
+			gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;
+		};
+
+		key-restart {
+			label = "Reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	/*
+	 * Rear-panel Ethernet LEDs. All ten sit on the BCM4908 parallel LED
+	 * engine (leds@800) at positions recovered from the stock firmware
+	 * (mod_bdutil table): 0/2/4/6 = LAN4/2/3/1 green, 17/18/19/26 =
+	 * LAN2/3/1/4 amber, 10/21 = WAN green/amber. Position 6 (LAN1
+	 * green) is the only one wired with inverted polarity, so every
+	 * other LED carries an explicit active-low override to keep the
+	 * polarity register in the state the hardware expects.
+	 */
+};
+
+&{/bus@ff800000} {
+	leds@800 {
+		compatible = "brcm,bcm63138-leds";
+		reg = <0x800 0xe0>;
+		status = "okay";
+
+		led_lan4_green: led@0 {
+			label = "lan4:green";
+			reg = <0>;
+			active-low;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_0_a>;
+		};
+
+		led_lan2_green: led@2 {
+			label = "lan2:green";
+			reg = <2>;
+			active-low;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_2_a>;
+		};
+
+		led_lan3_green: led@4 {
+			label = "lan3:green";
+			reg = <4>;
+			active-low;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_4_a>;
+		};
+
+		led_lan1_green: led@6 {
+			label = "lan1:green";
+			reg = <6>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_6_a>;
+		};
+
+		led_wan_green: led@10 {
+			label = "wan:green";
+			reg = <10>;
+			active-low;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_10_a>;
+		};
+
+		led_lan2_amber: led@17 {
+			label = "lan2:amber";
+			reg = <17>;
+			active-low;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_17_a>;
+		};
+
+		led_lan3_amber: led@18 {
+			label = "lan3:amber";
+			reg = <18>;
+			active-low;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_18_a>;
+		};
+
+		led_lan1_amber: led@19 {
+			label = "lan1:amber";
+			reg = <19>;
+			active-low;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_19_a>;
+		};
+
+		led_wan_amber: led@21 {
+			label = "wan:amber";
+			reg = <21>;
+			active-low;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_21_a>;
+		};
+
+		led_lan4_amber: led@26 {
+			label = "lan4:amber";
+			reg = <26>;
+			active-low;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_26_a>;
+		};
+		led_internet_amber: led@12 {
+			label = "internet:amber";
+			reg = <12>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_12_a>;
+		};
+
+		led_ethernet_amber: led@3 {
+			label = "ethernet:amber";
+			reg = <3>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_3_a>;
+		};
+
+		led_wps_white: led@14 {
+			label = "wps:white";
+			reg = <14>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_14_a>;
+		};
+
+		led_wps_amber: led@20 {
+			label = "wps:amber";
+			reg = <20>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_20_a>;
+		};
+
+		led_logo_white: led@15 {
+			label = "logo:white";
+			reg = <15>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_15_a>;
+		};
+
+		led_usb2_green: led@23 {
+			label = "usb2:green";
+			reg = <23>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_23_a>;
+		};
+
+		led_usb1_green: led@22 {
+			label = "usb1:green";
+			reg = <22>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pins_led_22_a>;
+		};
+
+
+
+
+
+
+
+
+
+
+
+
+	};
+};
+
+&usb_phy {
+	brcm,ioc = <1>;
+	status = "okay";
+};
+
+&ehci {
+	status = "okay";
+};
+
+&ohci {
+	status = "okay";
+};
+
+&xhci {
+	status = "okay";
+};
+
+&ports {
+	port@0 {
+		label = "lan4";
+	};
+
+	port@1 {
+		label = "lan2";
+	};
+
+	port@2 {
+		label = "lan3";
+	};
+
+	port@3 {
+		label = "lan1";
+	};
+
+	port@7 {
+		reg = <7>;
+		phy-mode = "internal";
+		phy-handle = <&phy12>;
+		label = "wan";
+	};
+};
+
+/* BCM4365E radios: 2x 5 GHz + 1x 2.4 GHz, 3x3 802.11ac */
+&pcie0 {
+	status = "okay";
+};
+
+&pcie1 {
+	status = "okay";
+};
+
+&pcie2 {
+	status = "okay";
+};
+
+&nand_controller {
+	brcm,wp-not-connected;
+	status = "okay";
+};
+
+&nandcs {
+	nand-ecc-strength = <4>;
+	nand-ecc-step-size = <512>;
+	nand-on-flash-bbt;
+
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	/*
+	 * Fixed layout as created by the stock firmware (verified from a
+	 * real unit's /proc/mtd). Two firmware slots, active one is picked
+	 * at boot by CFE; the kernel's ofpart bcm4908 post-parse selects
+	 * the OpenWrt one ("1-openwrt" bootfs marker).
+	 */
+	partitions {
+		compatible = "brcm,bcm4908-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "nvram";
+			reg = <0x0 0x100000>;
+		};
+
+		partition@100000 {
+			compatible = "brcm,bcm4908-firmware";
+			reg = <0x100000 0x4f80000>;
+		};
+
+		partition@5080000 {
+			compatible = "brcm,bcm4908-firmware";
+			reg = <0x5080000 0x4f80000>;
+		};
+
+		partition@a000000 {
+			label = "devinfo";
+			reg = <0xa000000 0x800000>;
+		};
+
+		partition@a800000 {
+			label = "sysdiag";
+			reg = <0xa800000 0x200000>;
+		};
+
+		partition@aa00000 {
+			label = "syscfg";
+			reg = <0xaa00000 0x4c00000>;
+		};
+
+		partition@f600000 {
+			label = "crash";
+			reg = <0xf600000 0x100000>;
+		};
+
+		partition@f700000 {
+			label = "data";
+			reg = <0xf700000 0x800000>;
+		};
+	};
+};
