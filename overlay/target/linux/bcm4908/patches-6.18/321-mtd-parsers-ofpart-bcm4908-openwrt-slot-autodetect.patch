From: OpenWrt community
Subject: mtd: parsers: ofpart bcm4908: auto-detect OpenWrt slot on dual-slot boards

--- a3/drivers/mtd/parsers/ofpart_bcm4908.c	2026-10-22 20:16:29
+++ b3/drivers/mtd/parsers/ofpart_bcm4908.c	2026-10-22 20:17:08
@@ -8,6 +8,7 @@
 #include <linux/of.h>
 #include <linux/mtd/mtd.h>
 #include <linux/slab.h>
+#include <linux/string.h>
 #include <linux/mtd/partitions.h>
 
 #include "ofpart_bcm4908.h"
@@ -47,16 +48,108 @@
 	return -ENOENT;
 }
 
+/*
+ * JFFS2 dirent walk helpers (little-endian on-media format, as produced
+ * by CFE bootfs images and OpenWrt's mkfs.jffs2 --little-endian).
+ *
+ * OpenWrt marks its firmware with a dummy "1-openwrt" file in the bootfs.
+ * Boards with two firmware slots (e.g. Linksys EA9300) don't provide
+ * NAND_RFS_OFS boot parameter, so scan both slots for that marker to
+ * figure out which slot contains the bootable OpenWrt firmware.
+ */
+struct bcm4908_partitions_dirent {
+	__le16 magic;
+	__le16 nodetype;
+	__le32 totlen;
+	__le32 hdr_crc;
+	__le32 pino;
+	__le32 version;
+	__le32 ino;
+	__le32 mctime;
+	u8 nsize;
+	u8 type;
+	u8 unused[2];
+	__le32 node_crc;
+	__le32 name_crc;
+	u8 name[];
+};
+
+#define BCM4908_PARTITIONS_JFFS2_MAGIC		0x1985
+#define BCM4908_PARTITIONS_NODETYPE_DIRENT	0xe001
+
+static bool bcm4908_partitions_slot_is_openwrt(struct mtd_info *mtd, u64 offset, u64 size)
+{
+	struct bcm4908_partitions_dirent *dent;
+	size_t retlen;
+	char name[32];
+	u32 off = offset;
+	u8 buf[128];
+	int err;
+	int i;
+
+	for (i = 0; i < 1000 && off < offset + size - sizeof(buf); i++) {
+		err = mtd_read(mtd, off, sizeof(buf), &retlen, buf);
+		if (err || retlen != sizeof(buf))
+			return false;
+
+		dent = (struct bcm4908_partitions_dirent *)buf;
+		if (le16_to_cpu(dent->magic) != BCM4908_PARTITIONS_JFFS2_MAGIC)
+			return false;
+
+		if (le16_to_cpu(dent->nodetype) == BCM4908_PARTITIONS_NODETYPE_DIRENT &&
+		    dent->nsize && dent->nsize <= sizeof(name)) {
+			err = mtd_read(mtd, off + sizeof(*dent), dent->nsize, &retlen, name);
+			if (err || retlen != dent->nsize)
+				return false;
+			name[dent->nsize] = 0;
+			if (!strcmp(name, "1-openwrt"))
+				return true;
+		}
+
+		off += (le32_to_cpu(dent->totlen) + 0x3) & ~0x3;
+	}
+
+	return false;
+}
+
 int bcm4908_partitions_post_parse(struct mtd_info *mtd, struct mtd_partition *parts, int nr_parts)
 {
 	long long fw_offset;
+	int first_fw = -1;
+	int openwrt_fw = -1;
 	int i;
 
 	fw_offset = bcm4908_partitions_fw_offset();
 
 	for (i = 0; i < nr_parts; i++) {
-		if (of_device_is_compatible(parts[i].of_node, "brcm,bcm4908-firmware")) {
-			if (fw_offset < 0 || parts[i].offset == fw_offset)
+		if (!of_device_is_compatible(parts[i].of_node, "brcm,bcm4908-firmware"))
+			continue;
+
+		if (fw_offset < 0) {
+			/*
+			 * No boot parameter telling the active slot. Pick the
+			 * slot containing OpenWrt's "1-openwrt" bootfs marker;
+			 * fall back to the first one (e.g. stock firmware).
+			 */
+			if (first_fw < 0)
+				first_fw = i;
+			if (openwrt_fw < 0 &&
+			    bcm4908_partitions_slot_is_openwrt(mtd, parts[i].offset, parts[i].size))
+				openwrt_fw = i;
+			continue;
+		}
+
+		if (parts[i].offset == fw_offset)
+			parts[i].name = "firmware";
+		else
+			parts[i].name = "backup";
+	}
+
+	if (fw_offset < 0) {
+		for (i = 0; i < nr_parts; i++) {
+			if (!of_device_is_compatible(parts[i].of_node, "brcm,bcm4908-firmware"))
+				continue;
+			if (openwrt_fw >= 0 ? i == openwrt_fw : i == first_fw)
 				parts[i].name = "firmware";
 			else
 				parts[i].name = "backup";
