#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Sets the DSA conduit (eth0) MAC address from et0macaddr, as stored in the
# unit's devinfo (fallback: nvram) flash store. Runs on the eth0 add event
# and caches the value for the rest of the boot.

[ "$ACTION" = "add" ] && [ "$INTERFACE" = "eth0" ] || exit 0

if [ ! -s /tmp/et0macaddr ]; then
	mtd=""
	for part in devinfo nvram; do
		mtd="$(sed -n "s/^\\(mtd[0-9]*\\):.* $part\$/\\1/p" /proc/mtd)"
		[ -n "$mtd" ] && break
	done
	if [ -n "$mtd" ]; then
		tr '\0' '\n' < "/dev/$mtd" 2>/dev/null |
			awk -F= 'tolower($1) == "et0macaddr" { print tolower($2); exit }' \
			> /tmp/et0macaddr
	fi
fi

if [ -s /tmp/et0macaddr ]; then
	ip link set dev "$INTERFACE" address "$(cat /tmp/et0macaddr)" 2>/dev/null
fi

exit 0
